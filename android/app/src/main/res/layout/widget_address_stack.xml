<?xml version="1.0" encoding="utf-8"?>
<!-- Android address stack of a widget (spec/SUBSCRIPTIONS.md section 10): one card per saved address.
     StackView is the platform's card stack: swipe up or down flips to the next card; it loops. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <StackView
        android:id="@+id/address_stack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:loopViews="true" />
</FrameLayout>
