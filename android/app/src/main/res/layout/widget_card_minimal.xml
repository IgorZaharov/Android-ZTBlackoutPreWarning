<?xml version="1.0" encoding="utf-8"?>
<!-- One address of the 2x2 «Мінімальний» widget's address stack (BlackoutMinimalGlanceWidget): the queue header with
     the address label under it, then the status, the caption and the countdown centred in the rest. Texts shrink to fit
     the card, so a resized widget stays filled as the Glance widget does. The top-right 34 x 34 dp stays empty: the
     Glance frame draws the refresh button there, 12 dp from the corner (BlackoutMinimalGlanceWidget). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_minimal_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/card_queue"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/card_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3BAE6FD"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- place of the refresh button -->
        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/card_status"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="26"
            android:autoSizeMaxTextSize="30sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_countdown_caption"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="14"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFA9B4C2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/card_countdown"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="26"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
